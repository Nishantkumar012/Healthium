# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthum
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_ACCESS_SECRET=your-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security Configuration
BCRYPT_ROUNDS=12
MFA_ISSUER=Healthum
MFA_WINDOW=2

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info

# Email Configuration (for future use)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@healthum.com

# SMS Configuration (for future use)
SMS_API_KEY=mock-key
SMS_FROM=HEALTHUM

# Payment Gateway Configuration (for future use)
PAYMENT_GATEWAY_KEY=mock-key
PAYMENT_GATEWAY_SECRET=mock-secret

# CORS Configuration
CORS_ORIGIN=*

# Application Secrets (Never commit these!)
APP_SECRET=your-app-secret-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-min
